{
  "name": "deltatrace-live",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts,.tsx",
    "check:bundle": "node scripts/check-bundle.mjs",
    "diagrams": "node scripts/build-diagrams.mjs",
    "ci": "npm run typecheck && npm run lint && npm run check:splash && npm test && npm run build && npm run check:bundle",
    "check:splash": "node --check public/splash.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.15.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "license": "Apache-2.0",
  "description": "DeltaTrace: Trust-Aware Alarm Grouping and Tuning for Pipelines",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiruthikpurpose/DeltaTrace.git"
  },
  "engines": {
    "node": ">=18"
  }
}
